# Copy to spring-boot/.env (or export as environment variables).
# Names are identical to the NestJS app's .env.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kanban
# sslmode for the JDBC connection: prefer (default) | require | disable
# Nest used ssl: { rejectUnauthorized: false } (encrypted, unverified) — "prefer"/"require" match that.
POSTGRES_SSLMODE=prefer

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Redis login rate limiting (JAV-37; optional) ---
# Start Redis with: docker compose -f compose.redis.yml up -d --wait
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW=60s
# SAME prefix across instances, DIFFERENT prefix per environment.
RATE_LIMIT_KEY_PREFIX=kanban:local:rate-limit
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
# Trust no proxies by default. See docs/api-contracts/login-rate-limit.md.
TRUSTED_PROXY_REGEX=(?!)

# --- Runtime ---
# production disables Swagger (/api/docs), exactly like the Nest app
NODE_ENV=development
PORT=1996

# --- Socket.IO (see MIGRATION.md → compatibility differences) ---
SOCKET_IO_PORT=1997
SOCKET_IO_ENABLED=true

# --- Flyway ---
# Set to true the FIRST time you point this app at a database that the Nest app
# (TypeORM synchronize) already created, so V1 is recorded as the baseline.
FLYWAY_BASELINE_ON_MIGRATE=false
